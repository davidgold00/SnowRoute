# Required for server-side openrouteservice geocoding and directions.
ORS_API_KEY=

# Public canonical origin used for metadata. This is not a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Recommended for production: shared public-endpoint rate limiting.
# If absent, SnowRoute uses a per-process in-memory fallback that is not
# sufficient protection across multiple serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Reserved account/cloud-persistence configuration.
# The current application has no live database adapter, OIDC callback/session
# flow, authenticated trip API, or guest importer. Setting these values does not
# enable accounts; see docs/DATABASE.md before any integration work.
DATABASE_URL=
AUTH_ISSUER=
AUTH_SECRET=
